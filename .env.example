NOVAXIS_ENV=local
NOVAXIS_DATABASE_URL=postgresql+psycopg://novaxis:novaxis@localhost:5432/novaxis
NOVAXIS_WORKER_ENABLED=true
NOVAXIS_LOG_LEVEL=INFO
NOVAXIS_TEST_DATABASE_URL=postgresql+psycopg://novaxis:novaxis@localhost:5432/novaxis_test
# Supabase: Project Settings -> API -> JWT Secret. Local default is fine only locally.
NOVAXIS_JWT_SECRET=dev-secret-change-me-before-any-deploy-0123456789
# LLM (Chunk 3). The SDK reads ANTHROPIC_API_KEY itself. Set NOVAXIS_LLM_PROVIDER=fake to
# run the worker offline with scripted replies.
ANTHROPIC_API_KEY=
NOVAXIS_LLM_PROVIDER=anthropic
NOVAXIS_MODEL_WORKER=claude-sonnet-5
NOVAXIS_MODEL_CLASSIFY=claude-haiku-4-5
NOVAXIS_MODEL_SUMMARISE=claude-haiku-4-5
# Channels (Chunk 2). Leave blank locally; adapters refuse to verify with an empty secret.
NOVAXIS_PUBLIC_BASE_URL=http://localhost:8000
NOVAXIS_TWILIO_ACCOUNT_SID=
NOVAXIS_TWILIO_AUTH_TOKEN=
NOVAXIS_POSTMARK_SERVER_TOKEN=
NOVAXIS_POSTMARK_INBOUND_TOKEN=
NOVAXIS_VISITOR_TOKEN_SECRET=
# Fernet key for sensitive intake fields. Generate: python -c 'from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())'
NOVAXIS_SENSITIVE_FIELDS_KEY=
# Media storage (Chunk 7). local writes under NOVAXIS_STORAGE_LOCAL_DIR; supabase uses Storage REST.
NOVAXIS_STORAGE_BACKEND=local
NOVAXIS_STORAGE_LOCAL_DIR=.novaxis-media
NOVAXIS_STORAGE_BUCKET=media
NOVAXIS_SUPABASE_URL=
NOVAXIS_SUPABASE_SERVICE_KEY=
# Scheduling (Chunk 8). Google OAuth app; redirect URI is NOVAXIS_PUBLIC_BASE_URL/integrations/google/callback.
NOVAXIS_GOOGLE_CLIENT_ID=
NOVAXIS_GOOGLE_CLIENT_SECRET=
NOVAXIS_HOLD_MINUTES=10
NOVAXIS_SLOTS_OFFERED=3
# Dashboard (Chunk 9). Supabase Auth password sign-in when both are set; otherwise local dev login.
NOVAXIS_SUPABASE_ANON_KEY=
NOVAXIS_PUBLIC_WEB_URL=http://localhost:3000
# Serverless hosting (Vercel). See docs/adr/0013-vercel-hosting.md.
NOVAXIS_DB_POOLER=false
NOVAXIS_INLINE_WORKER=false
NOVAXIS_CRON_SECRET=
NOVAXIS_DEMO_PASSCODE=
# Billing and sign-up. See docs/adr/0014-billing-onboarding.md. With no Stripe keys the
# provider is "demo": choosing a plan activates it and no money moves.
NOVAXIS_STRIPE_SECRET_KEY=
NOVAXIS_STRIPE_WEBHOOK_SECRET=
# {"standard": {"monthly": "price_...", "setup": "price_...", "metered": "price_..."}, "pilot": {...}}
NOVAXIS_STRIPE_PRICES={}
NOVAXIS_TRIAL_DAYS=14
NOVAXIS_TRIAL_MESSAGE_CAP=100
NOVAXIS_SIGNUP_MAX_TENANTS=50
# PLACEHOLDER prices in pence, shown on the billing page until the pilot sets real ones.
NOVAXIS_PRICE_SETUP_PENCE=50000
NOVAXIS_PRICE_MONTHLY_PENCE=30000
NOVAXIS_INCLUDED_MESSAGES=1000
NOVAXIS_OVERAGE_PENCE_PER_MESSAGE=20
