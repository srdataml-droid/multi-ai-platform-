NOVAXIS_ENV=local
NOVAXIS_DATABASE_URL=postgresql+psycopg://novaxis:novaxis@localhost:5432/novaxis
NOVAXIS_WORKER_ENABLED=true
NOVAXIS_LOG_LEVEL=INFO
NOVAXIS_TEST_DATABASE_URL=postgresql+psycopg://novaxis:novaxis@localhost:5432/novaxis_test
# Supabase: Project Settings -> API -> JWT Secret. Local default is fine only locally.
NOVAXIS_JWT_SECRET=dev-secret-change-me-before-any-deploy-0123456789
# Chunk 3: ANTHROPIC_API_KEY=
# Channels (Chunk 2). Leave blank locally; adapters refuse to verify with an empty secret.
NOVAXIS_PUBLIC_BASE_URL=http://localhost:8000
NOVAXIS_TWILIO_ACCOUNT_SID=
NOVAXIS_TWILIO_AUTH_TOKEN=
NOVAXIS_POSTMARK_SERVER_TOKEN=
NOVAXIS_POSTMARK_INBOUND_TOKEN=
NOVAXIS_VISITOR_TOKEN_SECRET=
